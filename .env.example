# QWeather API credentials
QWEATHER_LOCATION=116.41,39.92
QWEATHER_KID=your_kid
QWEATHER_PROJECT_ID=your_project_id

# Optional: override private key file path (default: app/secrets/ed25519-private.pem)
# QWEATHER_PRIVATE_KEY_FILE=/path/to/private.pem

# Optional: base URL for image links in messages (default: auto-detect from request)
# PUBLIC_BASE_URL=https://your-domain.com

# Optional: local base URL fallback (default: http://127.0.0.1:5000)
# LOCAL_BASE_URL=http://127.0.0.1:5000
