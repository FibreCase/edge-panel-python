# Copy to .env for Docker Compose. For local runs, export these variables first.

# QWeather API credentials
QWEATHER_LOCATION=116.41,39.92
QWEATHER_KID=your_kid
QWEATHER_PROJECT_ID=your_project_id

# Private key path inside the container; host file: ./secrets/ed25519-private.pem
# QWEATHER_PRIVATE_KEY_FILE=app/secrets/ed25519-private.pem

# AHT21/ENS160 HTTP server base URL
# In Docker, localhost refers to the container; use the sensor's LAN address.
LOCAL_TEMP_SERVER=http://localhost:38285

# ICS path relative to the backend working directory (/app in Docker).
# Docker: place the calendar at ./cache/events.ics on the host.
# Local run: place it at ./app/.cache/events.ics, or set an absolute file path.
# The calendar is reloaded on every event request.
EVENT_ICS_FILE=./app/.cache/events.ics
EVENT_TIMEZONE=Asia/Shanghai

# Server timezone and listening/published port
TZ=Asia/Shanghai
PORT=5000

# Message management password: exactly four ASCII digits; change before deployment.
MANAGE_PASSWORD=1234

# Optional: public base URL for image links in messages
# PUBLIC_BASE_URL=https://your-domain.com

# Optional: local base URL fallback (match PORT if changed)
# LOCAL_BASE_URL=http://127.0.0.1:5000
